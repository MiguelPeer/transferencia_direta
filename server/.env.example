# Porta do servidor de sinalizacao
PORT=8787

# URL publica usada para montar o link/QR da sala (troque em producao, ex: https://transferenciadireta.com.br)
PUBLIC_BASE_URL=http://localhost:8787

# Origens permitidas a abrir WebSocket/chamar a API (separadas por virgula)
ALLOWED_ORIGINS=http://localhost:8787,http://localhost:5173

# Colocar 1 se o servidor estiver atras de proxy/load balancer (habilita leitura de X-Forwarded-For)
TRUST_PROXY=0

# TURN - fallback pra quando os dois peers nao estao na
# mesma rede. Deixe tudo em branco pra rodar sem TURN (so P2P direto / mesma rede).
# Duas formas de configurar, dependendo do que o provedor oferece - preencha
# so uma:
#
# 1) Secret compartilhado (coturn, esquema REST) - o servidor calcula
#    credenciais efemeras (5min) sozinho:
TURN_SECRET=
#
# 2) Credencial fixa emitida no painel do provedor (ex: Metered.ca, que da
#    usuario/senha prontos em vez de um secret):
TURN_STATIC_USERNAME=
TURN_STATIC_CREDENTIAL=
#
# Nos dois casos, as URLs do(s) servidor(es) TURN (separadas por virgula):
TURN_URLS=
