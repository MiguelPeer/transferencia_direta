# Porta do servidor de sinalizacao
PORT=8787

# URL publica usada para montar o link/QR da sala (troque em producao, ex: https://poeira.app)
PUBLIC_BASE_URL=http://localhost:8787

# Origens permitidas a abrir WebSocket/chamar a API (separadas por virgula)
ALLOWED_ORIGINS=http://localhost:8787,http://localhost:5173

# Colocar 1 se o servidor estiver atras de proxy/load balancer (habilita leitura de X-Forwarded-For)
TRUST_PROXY=0

# TURN (etapa 4 do roadmap) - credenciais efemeras via esquema REST (coturn, Metered, etc)
# Deixe em branco para rodar sem TURN (so P2P direto / mesma rede)
TURN_SECRET=
TURN_URLS=
