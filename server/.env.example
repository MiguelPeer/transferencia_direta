# Porta do servidor de sinalizacao
PORT=8787

# URL publica usada para montar o link/QR da sala (troque em producao, ex: https://transferenciadireta.com.br)
PUBLIC_BASE_URL=http://localhost:8787

# Origens permitidas a abrir WebSocket/chamar a API (separadas por virgula)
ALLOWED_ORIGINS=http://localhost:8787,http://localhost:5173

# Colocar 1 se o servidor estiver atras de proxy/load balancer (habilita leitura de X-Forwarded-For)
TRUST_PROXY=0

# TURN - fallback pra quando os dois peers nao estao na
# mesma rede. Deixe tudo em branco pra rodar sem TURN (so P2P direto / mesma rede).
# Tres formas de configurar, dependendo do que o provedor oferece - preencha
# so uma (a primeira configurada, na ordem abaixo, e a que vale):
#
# 1) API do provedor que gera credencial com expiracao (ex: Metered.ca -
#    dashboard > TURN Server > Developers, pega o dominio e a secret key):
TURN_METERED_DOMAIN=
TURN_METERED_SECRET_KEY=
#
# 2) Secret compartilhado (coturn, esquema REST) - o servidor calcula
#    credenciais efemeras (5min) sozinho:
TURN_SECRET=
#
# 3) Credencial fixa emitida no painel do provedor, sem expiracao propria
#    (ultimo recurso - prefira as opcoes acima quando disponiveis):
TURN_STATIC_USERNAME=
TURN_STATIC_CREDENTIAL=
#
# Em todos os casos, as URLs do(s) servidor(es) TURN (separadas por virgula):
TURN_URLS=
