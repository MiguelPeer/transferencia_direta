{
  "name": "poeira-server",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor de sinalizacao WebSocket do projeto Poeira - nunca transporta o arquivo, so metadado de conexao",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
